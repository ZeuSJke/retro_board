# ──────────────────────────────────────────────────────────────────────────────
# RetroBoard — Backend Environment Variables
# Для локальной разработки без Docker
#
# Скопируй этот файл:  cp .env.example .env
# Затем заполни значения под своё окружение
# ──────────────────────────────────────────────────────────────────────────────

# ── База данных ───────────────────────────────────────────────────────────────
# Строка подключения к PostgreSQL
# Формат: postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql://retro:retro@localhost:5432/retroboard

# ── CORS ──────────────────────────────────────────────────────────────────────
# Адреса фронтенда, которым разрешены запросы к API
# Несколько значений — через запятую, без пробелов
CORS_ORIGINS=http://localhost:3000

# ── AI (self-hosted LiteLLM gateway) ──────────────────────────────────────────
# OpenAI-совместимый эндпоинт гейта (обязательно, иначе AI-функции отключены)
#AI_BASE_URL=https://llm-api.kirillbessonov.ru/v1
# Ключ гейта (можно оставить пустым, если гейт без авторизации)
#AI_API_KEY=
# Модель гейта
#AI_MODEL=qwen3.6-35b-a3b-mtp-ud-q8_k_xl
# Qwen3 — reasoning-модель: без отключения thinking content возвращается пустым.
#AI_DISABLE_THINKING=true
