# ──────────────────────────────────────────────────────────────────────────────
# RetroBoard — Backend Environment Variables (локальный запуск uvicorn)
# Скопируй в backend/.env:  cp .env.example .env
# ──────────────────────────────────────────────────────────────────────────────

# ── База данных ───────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://retro:retro@localhost:5432/retroboard

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:3080

# ── Workspaces & Admin (обязательно для старта без TESTING=true) ──────────────
ADMIN_LOGIN=localadmin
ADMIN_PASSWORD=local-dev-password-123
WORKSPACE_JWT_SECRET=local-dev-workspace-jwt-secret-at-least-32-chars
ADMIN_JWT_SECRET=local-dev-admin-jwt-secret-at-least-32-chars
#WORKSPACE_JWT_EXPIRE_HOURS=168

# ── Cookies & CSRF (для локального HTTP) ──────────────────────────────────────
SECURE_COOKIES=false
CSRF_ENABLED=true

# ── AI (подключение настраивается в /admin; в env — только ключ шифрования и лимиты) ──
#AI_SETTINGS_ENCRYPTION_KEY=

# ── Лимиты и таймауты (необязательно; ниже — значения по умолчанию) ──────────
#DB_CONNECT_TIMEOUT_S=5
#DB_STATEMENT_TIMEOUT_MS=30000
#DB_LOCK_TIMEOUT_MS=10000
#DB_POOL_TIMEOUT_S=10
#AI_MAX_CONCURRENCY=4
#AI_QUEUE_TIMEOUT_S=15
#AI_CONNECT_TIMEOUT_S=5
#MAX_REQUEST_BODY_BYTES=1048576
#WS_MAX_SIZE=65536
