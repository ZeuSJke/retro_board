# ──────────────────────────────────────────────────────────────────────────────
# RetroBoard — Environment Variables
# Скопируй этот файл в .env и заполни значения
#   cp .env.example .env
# ──────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ─────────────────────────────────────────────────────────────────
POSTGRES_DB=retroboard
POSTGRES_USER=retro
# ! Смени пароль перед деплоем на продакшн !
POSTGRES_PASSWORD=change_me_in_production

# ── Backend ────────────────────────────────────────────────────────────────────
# Разрешённые CORS-источники (через запятую, без пробелов)
CORS_ORIGINS=http://localhost:3080

# ── Workspaces & Admin ────────────────────────────────────────────────────────
# Страница управления пространствами: http://your-host/admin
# Логин и пароль для входа в /admin
# Требования: ADMIN_LOGIN — минимум 3 символа, не "admin"
#             ADMIN_PASSWORD — минимум 8 символов, не "changeme"
ADMIN_LOGIN=CHANGE_ME_to_your_admin_login
# ! Смени перед деплоем на продакшн !
ADMIN_PASSWORD=CHANGE_ME_to_your_admin_password_min_8_chars

# Секреты для подписи JWT-токенов
# Требования: минимум 32 символа, не "change-me-workspace-secret" / "change-me-admin-secret"
# ! Смени перед деплоем на продакшн !
WORKSPACE_JWT_SECRET=CHANGE_ME_to_at_least_32_random_characters
ADMIN_JWT_SECRET=CHANGE_ME_to_at_least_32_random_characters

# Срок жизни токена пространства (часов, по умолчанию 168 = 7 дней)
#WORKSPACE_JWT_EXPIRE_HOURS=168

# ── Jira (необязательно) ─────────────────────────────────────────────────────
# Для интеграции с Jira заполни все три переменные.
# Без них кнопка «Создать задачу в Jira» будет скрыта.
#JIRA_URL=https://your-org.atlassian.net
#JIRA_EMAIL=user@example.com
#JIRA_API_TOKEN=your_api_token
# Для on-premise Jira с самоподписанным сертификатом — установи false
#JIRA_VERIFY_SSL=true
