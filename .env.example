# ──────────────────────────────────────────────────────────────────────────────
# RetroBoard — Root Environment Template (для локального E2E / справочника)
# Основной деплой идёт через Helm-чарт k8s/helm/retro-board и Secret retro-board-secrets.
# Локальный Playwright (frontend/playwright.config.ts) читает ../.env.
# ──────────────────────────────────────────────────────────────────────────────

# ── Database (локальный запуск / E2E) ─────────────────────────────────────────
DATABASE_URL=postgresql://retro:retro@localhost:5432/retroboard

# ── Backend ───────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3080,http://localhost:3000

# ── Workspaces & Admin ────────────────────────────────────────────────────────
# Требования валидаторов Settings (при TESTING != true):
#   ADMIN_LOGIN          — >= 3 символов, не "admin"
#   ADMIN_PASSWORD       — >= 8 символов, не "changeme"
#   WORKSPACE_JWT_SECRET — >= 32 символов, не "change-me-workspace-secret"
#   ADMIN_JWT_SECRET     — >= 32 символов, не "change-me-admin-secret"
ADMIN_LOGIN=CHANGE_ME_to_your_admin_login
ADMIN_PASSWORD=CHANGE_ME_to_your_admin_password_min_8_chars
WORKSPACE_JWT_SECRET=CHANGE_ME_to_at_least_32_random_characters
ADMIN_JWT_SECRET=CHANGE_ME_to_at_least_32_random_characters
#WORKSPACE_JWT_EXPIRE_HOURS=168

# ── Cookies & CSRF ────────────────────────────────────────────────────────────
# Для HTTPS (k3s-dev / k3s-stage) оставлять true; для локального HTTP — false.
SECURE_COOKIES=false
#CSRF_ENABLED=true

# ── AI (OpenAI-совместимый /v1 шлюз) ─────────────────────────────────────────
#AI_BASE_URL=https://llm-api.kirillbessonov.ru/v1
#AI_API_KEY=
#AI_MODEL=qwen3.6-35b-a3b-mtp-ud-q8_k_xl
#AI_DISABLE_THINKING=true

# ── Лимиты и таймауты (необязательно; ниже — значения по умолчанию) ──────────
#DB_CONNECT_TIMEOUT_S=5
#DB_STATEMENT_TIMEOUT_MS=30000
#DB_LOCK_TIMEOUT_MS=10000
#DB_POOL_TIMEOUT_S=10
#AI_MAX_CONCURRENCY=4
#AI_QUEUE_TIMEOUT_S=15
#AI_CONNECT_TIMEOUT_S=5
#MAX_REQUEST_BODY_BYTES=1048576
#WS_MAX_SIZE=65536
