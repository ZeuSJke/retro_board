# ──────────────────────────────────────────────────────────────────────────────
# RetroBoard — Environment Variables
# Скопируй этот файл в .env и заполни значения
#   cp .env.example .env
# ──────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ─────────────────────────────────────────────────────────────────
POSTGRES_DB=retroboard
POSTGRES_USER=retro
# ! Смени пароль перед деплоем на продакшн !
POSTGRES_PASSWORD=change_me_in_production

# ── Backend ────────────────────────────────────────────────────────────────────
# Разрешённые CORS-источники (через запятую, без пробелов)
CORS_ORIGINS=http://localhost:3080

# ── Workspaces & Admin ────────────────────────────────────────────────────────
# Страница управления пространствами: http://your-host/admin
# Логин и пароль для входа в /admin
# Требования: ADMIN_LOGIN — минимум 3 символа, не "admin"
#             ADMIN_PASSWORD — минимум 8 символов, не "changeme"
ADMIN_LOGIN=CHANGE_ME_to_your_admin_login
# ! Смени перед деплоем на продакшн !
ADMIN_PASSWORD=CHANGE_ME_to_your_admin_password_min_8_chars

# Секреты для подписи JWT-токенов
# Требования: минимум 32 символа, не "change-me-workspace-secret" / "change-me-admin-secret"
# ! Смени перед деплоем на продакшн !
WORKSPACE_JWT_SECRET=CHANGE_ME_to_at_least_32_random_characters
ADMIN_JWT_SECRET=CHANGE_ME_to_at_least_32_random_characters

# Срок жизни токена пространства (часов, по умолчанию 168 = 7 дней)
#WORKSPACE_JWT_EXPIRE_HOURS=168

# ── Cookies & CSRF ───────────────────────────────────────────────────────────
# SECURE_COOKIES=true — только для HTTPS-деплоя; для локального HTTP-dev
# обязательно выставить false, иначе браузер не сохраняет/не шлёт куки.
#SECURE_COOKIES=false
# CSRF_ENABLED=false — только для E2E (в E2E лимитер тоже выключен через TESTING).
#CSRF_ENABLED=false

# ── AI (self-hosted LiteLLM gateway) ────────────────────────────────────────
# OpenAI-совместимый эндпоинт гейта (обязательно, иначе AI-функции отключены)
#AI_BASE_URL=https://llm-api.kirillbessonov.ru/v1
# Ключ гейта (можно оставить пустым, если гейт без авторизации)
#AI_API_KEY=
# Модель гейта
#AI_MODEL=qwen3.6-35b-a3b-mtp-ud-q8_k_xl
# Qwen3 — reasoning-модель: без отключения thinking content возвращается пустым.
# Рекомендуется оставить true.
#AI_DISABLE_THINKING=true

# ── Dokploy ──────────────────────────────────────────────────────────────
# Абсолютный путь на хосте, где лежит каталог данных PostgreSQL.
# Используется только в docker-compose.dokploy.yml.
#PGDATA_HOST_PATH=/srv/apps/retroboard/pgdata
